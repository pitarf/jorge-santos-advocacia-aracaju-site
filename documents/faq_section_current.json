            "elements": [
                {
                    "id": "46dc0abd",
                    "elType": "widget",
                    "settings": {
                        "ekit_accordion_items": [
                            {
                                "_id": "h_faq_1",
                                "acc_title": "Como escolher um advogado em Aracaju?",
                                "acc_content": "<p>É recomendável verificar a regularidade profissional, conhecer as áreas de atuação informadas pelo advogado ou escritório e apresentar os documentos e fatos relacionados à demanda para que seja possível realizar uma avaliação jurídica adequada.</p>",
                                "ekit_acc_is_active": "yes"
                            },
                            {
                                "_id": "h_faq_2",
                                "acc_title": "Quais documentos devo levar para uma consulta com advogado?",
                                "acc_content": "<p>Os documentos dependem do assunto. Contratos, documentos pessoais, comprovantes, mensagens, notificações, decisões judiciais, certidões e outros registros relacionados ao problema podem ser relevantes.</p>"
                            },
                            {
                                "_id": "h_faq_3",
                                "acc_title": "É possível receber atendimento jurídico mesmo estando em outra cidade?",
                                "acc_content": "<p>Diversas etapas do atendimento jurídico podem ser realizadas por meios digitais, dependendo das características do caso e dos atos que precisem ser praticados.</p>"
                            },
                            {
                                "_id": "h_faq_4",
                                "acc_title": "O escritório atende empresas em Aracaju?",
                                "acc_content": "<p>A Jorge Santos Advocacia e Consultoria Jurídica presta assessoria em <strong>Direito Empresarial e Direito Trabalhista empresarial</strong>, incluindo contratos, cobranças, prevenção de riscos e defesa em processos.</p>"
                            },
                            {
                                "_id": "h_faq_5",
                                "acc_title": "O escritório atua com Direito Trabalhista em Aracaju?",
                                "acc_content": "<p>Sim. A atuação compreende demandas relacionadas aos direitos e obrigações decorrentes das relações de trabalho, tanto para trabalhadores quanto para empresas.</p>"
                            },
                            {
                                "_id": "h_faq_6",
                                "acc_title": "O escritório atua com divórcio em Aracaju?",
                                "acc_content": "<p>Sim. São analisadas questões relacionadas a divórcio consensual ou litigioso, partilha patrimonial e demais consequências jurídicas relacionadas ao encerramento do casamento.</p>"
                            },
                            {
                                "_id": "h_faq_7",
                                "acc_title": "O escritório atua com Direito Imobiliário em Aracaju?",
                                "acc_content": "<p>Sim. A atuação pode envolver compra e venda, contratos, regularização de imóveis, usucapião, distrato, imóveis na planta, locações e conflitos imobiliários.</p>"
                            },
                            {
                                "_id": "h_faq_8",
                                "acc_title": "O escritório realiza inventário em Aracaju?",
                                "acc_content": "<p>O escritório presta orientação e acompanhamento em inventários e questões relacionadas a herança e partilha de bens, observando a modalidade juridicamente adequada a cada situação.</p>"
                            }
                        ],
